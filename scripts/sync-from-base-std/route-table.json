    {
      "$comment": "Per-feature entries (NN_Hardfork_Product_feature.md) for B20 products only: B20, B20Asset, B20Stablecoin, B20Factory, PolicyRegistry, ActivationRegistry. Entries for other Base standards in base-std (e.g. 03_Denim_BaseTime_*) do not match: the file is reported as unrouted and its changelog/README.md row is skipped on the B20 changelog summary. The docs page is derived from the filename via page_template: each named group is lowercased with underscores replaced by hyphens, matching the naming convention in docs/content-guidelines.md. AGENTS.md / TEMPLATE_* never match.",
      "source_prefix": "changelog/",
      "source_pattern": "^changelog/(?<ordinal>\\d{2})_(?<hardfork>[A-Za-z0-9]+)_(?<product>B20[A-Za-z0-9]*|PolicyRegistry|ActivationRegistry)_(?<feature>[A-Za-z0-9_]+)\\.md$",
      "kind": "changelog-entry",
      "transformer": "claude",
      "page_template": "docs/base-chain/specs/reference/b20/changelog/{ordinal}-{hardfork}-{product}-{feature}.mdx",
      "pages": []
    }
  ],
  "release": {
