      "$comment": "Per-feature entries (NN_Hardfork_Product_feature.md). The docs page is derived from the filename via page_template: each named group is lowercased with underscores replaced by hyphens, matching the naming convention in docs/content-guidelines.md. AGENTS.md / TEMPLATE_* never match.",
      "source_prefix": "changelog/",
      "source_pattern": "^changelog/(?<ordinal>\\d{2})_(?<hardfork>[A-Za-z0-9]+)_(?<product>[A-Za-z0-9]+)_(?<feature>[A-Za-z0-9_]+)\\.md$",
      "kind": "changelog-entry",
      "transformer": "claude",
      "page_template": "docs/base-chain/specs/reference/b20/changelog/{ordinal}-{hardfork}-{product}-{feature}.mdx"
