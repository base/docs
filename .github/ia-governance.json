{
  "$comment": "Config for the IA approval gates. ALWAYS read from the default branch, never from a PR head. See .github/scripts/check-ia-approvals.mjs and docs/ia-guidelines.md.",

  "governanceOwners": [
    "ericbrown99",
    "mindapivessa"
  ],

  "gates": {
    "get-started": {
      "checkName": "IA Gate / Get Started Pages",
      "requires": "writers",
      "count": 3,
      "navTab": "Get Started",
      "addedPathGlobs": [
        "docs/get-started/**/*.md",
        "docs/get-started/**/*.mdx"
      ]
    },
    "build-on-base-solutions": {
      "checkName": "IA Gate / Build on Base Solutions",
      "requires": "governanceOwners",
      "count": 1,
      "navTab": "Build on Base"
    },
    "guideline-files": {
      "checkName": "IA Gate / Guideline Files",
      "requires": "governanceOwners",
      "count": 1,
      "touchedPathGlobs": [
        "docs/ia-guidelines.md",
        "docs/content-guidelines.md",
        "ia-guidelines.md",
        "content-guidelines.md"
      ]
    },
    "ci-configuration": {
      "checkName": "IA Gate / CI Configuration",
      "requires": "writers",
      "count": 3,
      "touchedPathGlobs": [
        ".github/ia-governance.json",
        ".github/CODEOWNERS",
        ".github/scripts/**",
        ".github/workflows/ia-approval-gates.yml",
        ".github/workflows/docs-style-conformance.yml",
        ".github/workflows/governance-docs-approval.yml"
      ]
    }
  },

  "navConfigPath": "docs/docs.json"
}
